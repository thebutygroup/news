# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-something-long
ANTHROPIC_API_KEY=
# Web search must also be switched on for your org in the Anthropic Console.

# --- Identity (Cloudflare Access) -------------------------------------------
# Recommended: verify the signed Access token. Both values are in Zero Trust >
# Access > Applications > (your app). Team domain looks like yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Fallback if you can't set the two above: trust the email header as-is.
# Only safe while the container port is reachable solely through the tunnel.
TRUST_CF_EMAIL_HEADER=0
# Local development only: pretend everyone is this user.
DEV_USER_EMAIL=
# Comma-separated. Admins can start scans, approve sources and hide posts.
ADMIN_EMAILS=

# --- Schedule ---------------------------------------------------------------
APP_TIMEZONE=Europe/London
SCAN_CRON=0 4,13 * * *

# --- Models and spend caps --------------------------------------------------
# Scans, twice a day
CURATE_MODEL=claude-haiku-4-5-20251001
CLUSTER_MODEL=claude-haiku-4-5-20251001
DISCOVERY_MODEL=claude-haiku-4-5-20251001
WEB_SEARCH_TOOL=web_search_20250305
MAX_SEARCHES_PER_RUN=12
MAX_LLM_CALLS_PER_RUN=40
MAX_CANDIDATES_PER_RUN=250
# Briefings: a morning and an afternoon edition after the scheduled scans, each covering only what's new
DIGEST_ENABLED=1
DIGEST_MODEL=claude-sonnet-5
DIGEST_WORDS=250
DIGEST_MAX_WORDS=400
DIGEST_FULLTEXT_STORIES=12
# Audio for each edition, two a day.
# PODCAST_TTS: edge (free, unofficial endpoint), azure (official, key) or elevenlabs (most natural, key,
# about one credit per character: PODCAST_WORDS=500 is roughly 3,000 credits an edition, 6,000 a day).
PODCAST_ENABLED=1
PODCAST_MODEL=claude-haiku-4-5-20251001
PODCAST_WORDS=500
PODCAST_TTS=edge
PODCAST_VOICE_A=en-GB-RyanNeural
PODCAST_VOICE_B=en-GB-SoniaNeural
# The real key starts with sk_ and is only shown when it's created; the key ID won't work.
ELEVENLABS_API_KEY=
# eleven_flash_v2_5 uses about half the credits, with slightly flatter voices.
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice ids from your ElevenLabs voice library. Defaults: George and Alice (British).
ELEVENLABS_VOICE_A=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_B=Xb7hH8MSUJpSbSDYk0k2
# Paid voices stop here. The written summary still publishes when a limit is hit.
PODCAST_MAX_CHARS_PER_EPISODE=6000
PODCAST_MONTHLY_CHAR_LIMIT=120000
# Manual scans (Scan now, --once) are refused this soon after the last one, unless forced.
SCAN_COOLDOWN_MINUTES=30
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uksouth
PUBLIC_BASE_URL=https://news.thebutygroup.com
# Set to 1 to run the whole pipeline with keyword heuristics instead of Claude. No API key needed.
LLM_FAKE=0

# --- Tuning -----------------------------------------------------------------
LOOKBACK_HOURS=36
FIRST_RUN_LOOKBACK_HOURS=72
STORY_TAG_THRESHOLD=2
PROPOSED_SOURCE_THRESHOLD=3

# --- Support strip ------------------------------------------------------------
# A slim thank-you message at the top of the feed. Leave SUPPORT_URL empty to hide it.
SUPPORT_URL=
# SUPPORT_TEXT=Thanks for reading. This is a one-person side project. If it's useful, subscribing to my Substack helps keep it going.
# SUPPORT_LABEL=Subscribe on Substack

# --- Networking -------------------------------------------------------------
WEB_PORT=8088
# Writes from other origins are refused. If votes fail with "cross-origin write refused",
# your proxy is rewriting the Host header: list the public host here.
ALLOWED_HOSTS=news.thebutygroup.com
# Only for docker-compose.tunnel.yml
TUNNEL_NETWORK=
